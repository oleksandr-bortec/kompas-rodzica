# Skopiuj do .env.local (lokalnie) albo ustaw w Vercel → Settings → Environment Variables.
# Nigdy nie commituj prawdziwych wartości.

# Hasło do panelu /admin. Bez niego panel działa tylko lokalnie (npm run dev).
ADMIN_PASSWORD=

# Klucz Claude API do odczytu akt w „Sprawdź sprawę” (tylko po stronie serwera).
# Bez niego działają przykładowe sprawy (plan B), a wgranie PDF zwraca czytelny komunikat.
ANTHROPIC_API_KEY=
